{
  "name": "memaster-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "node scripts/prepare-assets.mjs && tsc -b && vite build && node scripts/check-no-e2e-wallet.mjs && node scripts/check-mythics.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "indexer": "node indexer/indexer.mjs",
    "test": "vitest run && node scripts/check-mythics.mjs",
    "check:mythics": "node scripts/check-mythics.mjs",
    "smoke": "node scripts/smoke-readonly.mjs"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@walletconnect/sign-client": "2.26.0",
    "framer-motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
