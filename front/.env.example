# Copier en .env.local si besoin. Aucune clé n'est nécessaire pour la démo.
VITE_NETWORK=testnet
VITE_CONTRACT_ID=app3.memaster-demo-j7xg7z.testnet
VITE_RPC_URL=https://rpc.testnet.fastnear.com
VITE_SERIES_ID=0
# WalletConnect (wallets mobiles, MetaMask sur iOS) : projectId gratuit sur https://cloud.reown.com. Vide : désactivé.
VITE_WALLETCONNECT_PROJECT_ID=
# Temps moyen d'un bloc testnet, en secondes (comptes à rebours du gold rush)
VITE_BLOCK_TIME_S=0.6

# Indexeur (npm run indexer) : Trending, ventes récentes, résurrections. Facultatif.
VITE_INDEXER_URL=http://127.0.0.1:8787
# INDEXER_PORT=8787
# INDEXER_HOST=127.0.0.1   (0.0.0.0 : ouvert au réseau local)
# INDEXER_TX_API=https://tx.test.fastnear.com

# Vite écoute sur 127.0.0.1 ; DEV_HOST=0.0.0.0 pour ouvrir au réseau local (variable du shell, pas du front).
# DEV_HOST=127.0.0.1

# Adresse de contact des mentions légales (facultative ; vide : non affichée).
VITE_CONTACT_EMAIL=
