# Copy to .env.local if needed. No key is required for the demo.
VITE_NETWORK=testnet
VITE_CONTRACT_ID=app4.simpletea5483.testnet
VITE_RPC_URL=https://rpc.testnet.fastnear.com
VITE_SERIES_ID=0
# WalletConnect (mobile wallets, MetaMask on iOS): free projectId at https://cloud.reown.com. Empty: disabled.
VITE_WALLETCONNECT_PROJECT_ID=
# Average testnet block time, in seconds (gold rush countdowns)
VITE_BLOCK_TIME_S=0.6

# Indexer (npm run indexer): Trending, recent sales, resurrections. Optional.
VITE_INDEXER_URL=http://127.0.0.1:8787
# INDEXER_PORT=8787
# INDEXER_HOST=127.0.0.1   (0.0.0.0: open to the local network)
# INDEXER_TX_API=https://tx.test.fastnear.com

# Vite listens on 127.0.0.1; DEV_HOST=0.0.0.0 opens it to the local network (shell variable, not a front-end one).
# DEV_HOST=127.0.0.1

# Contact address on the legal notice page (optional; empty: not shown).
VITE_CONTACT_EMAIL=
